# EmailJS Configuration for Contact Form
# Sign up at https://www.emailjs.com/
# 1. Create an Email Service (e.g., Gmail) -> VITE_EMAILJS_SERVICE_ID
# 2. Create an Email Template -> VITE_EMAILJS_TEMPLATE_ID
#    Template variables: {{from_name}}, {{from_email}}, {{message}}
#    Destination: dhruvikagannamani@gmail.com
# 3. Get your Public Key under Account Settings -> VITE_EMAILJS_PUBLIC_KEY
#
# IMPORTANT: When deploying to Vercel/Netlify, add these same environment variables in your project settings.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
